generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model allowance_types {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                   @db.VarChar(60)
  code                String                   @unique @db.VarChar(20)
  default_amount      Decimal?                 @db.Decimal(12, 2)
  default_frequency   allowance_frequency_enum @default(monthly)
  is_active           Boolean                  @default(true)
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  employee_allowances employee_allowances[]
}

model asset_assignments {
  id                                                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id                                           String                       @db.Uuid
  employee_id                                        String                       @db.Uuid
  assigned_on                                        DateTime                     @default(dbgenerated("CURRENT_DATE")) @db.Date
  assigned_by                                        String?                      @db.Uuid
  accepted_by_employee                               Boolean                      @default(false)
  accepted_at                                        DateTime?                    @db.Timestamptz(6)
  condition_at_assignment                            asset_condition_enum?
  returned_on                                        DateTime?                    @db.Date
  condition_at_return                                asset_condition_enum?
  return_processed_by                                String?                      @db.Uuid
  status                                             asset_assignment_status_enum @default(assigned)
  created_at                                         DateTime                     @default(now()) @db.Timestamptz(6)
  assets                                             assets                       @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_asset_assignments_assigned_byTousers         users?                       @relation("asset_assignments_assigned_byTousers", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees                                          employees                    @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_asset_assignments_return_processed_byTousers users?                       @relation("asset_assignments_return_processed_byTousers", fields: [return_processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([asset_id], map: "idx_asset_assignments_asset")
  @@index([employee_id], map: "idx_asset_assignments_employee")
}

model asset_requests {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id           String                    @db.Uuid
  asset_type_requested  String                    @db.VarChar(50)
  reason                String?
  onboarding_process_id String?                   @db.Uuid
  status                asset_request_status_enum @default(pending)
  fulfilled_asset_id    String?                   @db.Uuid
  requested_at          DateTime                  @default(now()) @db.Timestamptz(6)
  resolved_at           DateTime?                 @db.Timestamptz(6)
  employees             employees                 @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assets                assets?                   @relation(fields: [fulfilled_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  onboarding_processes  onboarding_processes?     @relation(fields: [onboarding_process_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_asset_requests_status")
}

model assets {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_code          String               @unique @db.VarChar(30)
  asset_type          String               @db.VarChar(50)
  serial_number       String?              @db.VarChar(100)
  purchase_date       DateTime?            @db.Date
  purchase_cost       Decimal?             @db.Decimal(12, 2)
  warranty_expiry     DateTime?            @db.Date
  condition           asset_condition_enum @default(good)
  status              asset_status_enum    @default(available)
  location            String?              @db.VarChar(100)
  current_employee_id String?              @db.Uuid
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
  asset_assignments   asset_assignments[]
  asset_requests      asset_requests[]
  employees           employees?           @relation(fields: [current_employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  it_tickets          it_tickets[]

  @@index([current_employee_id], map: "idx_assets_current_employee")
  @@index([status], map: "idx_assets_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  id                             String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                    String                           @db.Uuid
  attendance_date                DateTime                         @db.Date
  check_in                       DateTime?                        @db.Timestamptz(6)
  check_out                      DateTime?                        @db.Timestamptz(6)
  working_hours                  Decimal?                         @default(dbgenerated("\nCASE\n    WHEN ((check_in IS NOT NULL) AND (check_out IS NOT NULL)) THEN round((EXTRACT(epoch FROM (check_out - check_in)) / (3600)::numeric), 2)\n    ELSE (0)::numeric\nEND")) @db.Decimal(6, 2)
  overtime_hours                 Decimal                          @default(0) @db.Decimal(6, 2)
  status                         attendance_status_enum           @default(present)
  is_manually_corrected          Boolean                          @default(false)
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  employees                      employees                        @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attendance_correction_requests attendance_correction_requests[]

  @@unique([employee_id, attendance_date])
  @@index([employee_id, attendance_date(sort: Desc)], map: "idx_attendance_employee_date")
  @@index([status], map: "idx_attendance_status")
}

model attendance_correction_requests {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendance_id       String                 @db.Uuid
  employee_id         String                 @db.Uuid
  requested_check_in  DateTime?              @db.Timestamptz(6)
  requested_check_out DateTime?              @db.Timestamptz(6)
  reason              String
  status              correction_status_enum @default(pending)
  reviewed_by         String?                @db.Uuid
  reviewed_at         DateTime?              @db.Timestamptz(6)
  review_note         String?
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  attendance          attendance             @relation(fields: [attendance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees           employees              @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?                 @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_correction_requests_status")
}

model audit_log {
  id         BigInt            @id @default(autoincrement())
  table_name String
  record_id  String            @db.Uuid
  action     audit_action_enum
  changed_by String?           @db.Uuid
  old_data   Json?
  new_data   Json?
  changed_at DateTime          @default(now()) @db.Timestamptz(6)
  users      users?            @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_user")

  @@index([table_name, record_id, changed_at(sort: Desc)], map: "idx_audit_log_record")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model contracts {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contract_number        String                  @unique @db.VarChar(50)
  employee_id            String                  @db.Uuid
  contract_type          contract_type_enum      @default(permanent)
  department_id          String?                 @db.Uuid
  designation_id         String?                 @db.Uuid
  salary                 Decimal                 @db.Decimal(12, 2)
  working_hours_per_week Decimal?                @db.Decimal(5, 2)
  start_date             DateTime                @db.Date
  end_date               DateTime?               @db.Date
  status                 contract_status_enum    @default(draft)
  document_url           String?
  employee_accepted      Boolean                 @default(false)
  accepted_at            DateTime?               @db.Timestamptz(6)
  created_by             String?                 @db.Uuid
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  users                  users?                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments            departments?            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designations           designations?           @relation(fields: [designation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees              employees               @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payroll_run_employees  payroll_run_employees[]
  payslips               payslips[]

  @@index([employee_id], map: "idx_contracts_employee")
  @@index([status], map: "idx_contracts_status")
}

model departments {
  id                                                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                              String                 @db.VarChar(100)
  code                                              String?                @unique @db.VarChar(20)
  parent_department_id                              String?                @db.Uuid
  head_employee_id                                  String?                @db.Uuid
  created_at                                        DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime               @default(now()) @db.Timestamptz(6)
  contracts                                         contracts[]
  departments                                       departments?           @relation("departmentsTodepartments", fields: [parent_department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_departments                                 departments[]          @relation("departmentsTodepartments")
  employees_departments_head_employee_idToemployees employees?             @relation("departments_head_employee_idToemployees", fields: [head_employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_departments_head")
  designations                                      designations[]
  employees_employees_department_idTodepartments    employees[]            @relation("employees_department_idTodepartments")
  onboarding_templates                              onboarding_templates[]
  payroll_runs                                      payroll_runs[]
  salary_structures                                 salary_structures[]
}

model designations {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String                 @db.VarChar(100)
  department_id        String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  contracts            contracts[]
  departments          departments?           @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees            employees[]
  onboarding_templates onboarding_templates[]
  salary_structures    salary_structures[]
}

model employee_allowances {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id       String                   @db.Uuid
  allowance_type_id String                   @db.Uuid
  amount            Decimal                  @db.Decimal(12, 2)
  frequency         allowance_frequency_enum @default(monthly)
  status            allowance_status_enum    @default(active)
  effective_from    DateTime                 @default(dbgenerated("CURRENT_DATE")) @db.Date
  effective_to      DateTime?                @db.Date
  configured_by     String?                  @db.Uuid
  created_at        DateTime                 @default(now()) @db.Timestamptz(6)
  allowance_types   allowance_types          @relation(fields: [allowance_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?                   @relation(fields: [configured_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees         employees                @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id, status], map: "idx_employee_allowances_employee")
}

model employee_documents {
  id                                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                 String    @db.Uuid
  document_type                               String    @db.VarChar(60)
  file_url                                    String
  uploaded_by                                 String?   @db.Uuid
  is_verified                                 Boolean   @default(false)
  verified_by                                 String?   @db.Uuid
  verified_at                                 DateTime? @db.Timestamptz(6)
  uploaded_at                                 DateTime  @default(now()) @db.Timestamptz(6)
  employees                                   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_employee_documents_uploaded_byTousers users?    @relation("employee_documents_uploaded_byTousers", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_employee_documents_verified_byTousers users?    @relation("employee_documents_verified_byTousers", fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employee_documents_employee")
}

model employee_salary_structures {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id       String            @db.Uuid
  structure_id      String            @db.Uuid
  effective_from    DateTime          @db.Date
  effective_to      DateTime?         @db.Date
  is_current        Boolean           @default(true)
  assigned_by       String?           @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  users             users?            @relation(fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees         employees         @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  salary_structures salary_structures @relation(fields: [structure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model employees {
  id                                                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_code                                        String                           @unique @db.VarChar(20)
  full_name                                            String                           @db.VarChar(150)
  email                                                String                           @unique
  phone                                                String?                          @db.VarChar(20)
  date_of_birth                                        DateTime?                        @db.Date
  gender                                               gender_enum?
  profile_photo_url                                    String?
  joining_date                                         DateTime                         @db.Date
  department_id                                        String?                          @db.Uuid
  designation_id                                       String?                          @db.Uuid
  reporting_manager_id                                 String?                          @db.Uuid
  employment_type                                      employment_type_enum             @default(full_time)
  status                                               employee_status_enum             @default(onboarding)
  bank_name                                            String?                          @db.VarChar(100)
  bank_account_number                                  String?                          @db.VarChar(50)
  bank_ifsc_code                                       String?                          @db.VarChar(20)
  emergency_contact_name                               String?                          @db.VarChar(100)
  emergency_contact_phone                              String?                          @db.VarChar(20)
  address                                              String?
  alternate_phone                                      String?                          @db.VarChar(20)
  exit_date                                            DateTime?                        @db.Date
  created_at                                           DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                                           DateTime                         @default(now()) @db.Timestamptz(6)
  asset_assignments                                    asset_assignments[]
  asset_requests                                       asset_requests[]
  assets                                               assets[]
  attendance                                           attendance[]
  attendance_correction_requests                       attendance_correction_requests[]
  contracts                                            contracts[]
  departments_departments_head_employee_idToemployees  departments[]                    @relation("departments_head_employee_idToemployees")
  employee_allowances                                  employee_allowances[]
  employee_documents                                   employee_documents[]
  employee_salary_structures                           employee_salary_structures[]
  departments_employees_department_idTodepartments     departments?                     @relation("employees_department_idTodepartments", fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designations                                         designations?                    @relation(fields: [designation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees                                            employees?                       @relation("employeesToemployees", fields: [reporting_manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_employees                                      employees[]                      @relation("employeesToemployees")
  it_tickets                                           it_tickets[]
  leave_allocations                                    leave_allocations[]
  leave_requests_leave_requests_employee_idToemployees leave_requests[]                 @relation("leave_requests_employee_idToemployees")
  leave_requests_leave_requests_manager_idToemployees  leave_requests[]                 @relation("leave_requests_manager_idToemployees")
  offboarding_processes                                offboarding_processes[]
  onboarding_processes                                 onboarding_processes?
  payroll_exceptions                                   payroll_exceptions[]
  payroll_run_employees                                payroll_run_employees[]
  payslips                                             payslips[]
  reimbursements                                       reimbursements[]
  service_accounts                                     service_accounts[]
  users                                                users?

  @@index([department_id], map: "idx_employees_department")
  @@index([reporting_manager_id], map: "idx_employees_manager")
  @@index([status], map: "idx_employees_status")
}

model it_ticket_activity {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id  String     @db.Uuid
  changed_by String?    @db.Uuid
  field_name String     @db.VarChar(30)
  old_value  String?
  new_value  String?
  changed_at DateTime   @default(now()) @db.Timestamptz(6)
  users      users?     @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  it_tickets it_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model it_ticket_attachments {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id   String     @db.Uuid
  file_url    String
  uploaded_by String?    @db.Uuid
  uploaded_at DateTime   @default(now()) @db.Timestamptz(6)
  it_tickets  it_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?     @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model it_ticket_comments {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id  String     @db.Uuid
  user_id    String     @db.Uuid
  comment    String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  it_tickets it_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ticket_id, created_at], map: "idx_ticket_comments_ticket")
}

model it_tickets {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_number         String                  @unique @db.VarChar(30)
  employee_id           String                  @db.Uuid
  category              ticket_category_enum
  priority              ticket_priority_enum    @default(medium)
  subject               String                  @db.VarChar(150)
  description           String?
  linked_asset_id       String?                 @db.Uuid
  status                ticket_status_enum      @default(open)
  assigned_to           String?                 @db.Uuid
  resolved_at           DateTime?               @db.Timestamptz(6)
  closed_at             DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  it_ticket_activity    it_ticket_activity[]
  it_ticket_attachments it_ticket_attachments[]
  it_ticket_comments    it_ticket_comments[]
  users                 users?                  @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees             employees               @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assets                assets?                 @relation(fields: [linked_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assigned_to], map: "idx_it_tickets_assigned")
  @@index([employee_id], map: "idx_it_tickets_employee")
  @@index([status], map: "idx_it_tickets_status")
}

model leave_allocations {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id    String           @db.Uuid
  leave_type_id  String           @db.Uuid
  year           Int
  allocated_days Decimal          @default(0) @db.Decimal(5, 2)
  used_days      Decimal          @default(0) @db.Decimal(5, 2)
  remaining_days Decimal?         @default(dbgenerated("(allocated_days - used_days)")) @db.Decimal(5, 2)
  adjusted_by    String?          @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  users          users?           @relation(fields: [adjusted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees      employees        @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leave_types    leave_types      @relation(fields: [leave_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leave_requests leave_requests[]

  @@unique([employee_id, leave_type_id, year])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leave_requests {
  id                                              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                     String                    @db.Uuid
  leave_type_id                                   String                    @db.Uuid
  allocation_id                                   String?                   @db.Uuid
  start_date                                      DateTime                  @db.Date
  end_date                                        DateTime                  @db.Date
  days                                            Decimal                   @db.Decimal(5, 2)
  reason                                          String?
  status                                          leave_request_status_enum @default(pending)
  manager_id                                      String?                   @db.Uuid
  manager_decision                                correction_status_enum?
  manager_decided_at                              DateTime?                 @db.Timestamptz(6)
  hr_decided_by                                   String?                   @db.Uuid
  hr_decision                                     correction_status_enum?
  hr_decided_at                                   DateTime?                 @db.Timestamptz(6)
  cancelled_at                                    DateTime?                 @db.Timestamptz(6)
  created_at                                      DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime                  @default(now()) @db.Timestamptz(6)
  leave_allocations                               leave_allocations?        @relation(fields: [allocation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees_leave_requests_employee_idToemployees employees                 @relation("leave_requests_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                           users?                    @relation(fields: [hr_decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leave_types                                     leave_types               @relation(fields: [leave_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees_leave_requests_manager_idToemployees  employees?                @relation("leave_requests_manager_idToemployees", fields: [manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([start_date, end_date], map: "idx_leave_requests_dates")
  @@index([employee_id, status], map: "idx_leave_requests_employee")
}

model leave_types {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String              @db.VarChar(60)
  code                      String              @unique @db.VarChar(20)
  is_paid                   Boolean             @default(true)
  requires_allocation       Boolean             @default(true)
  default_annual_allocation Decimal?            @default(0) @db.Decimal(5, 2)
  is_active                 Boolean             @default(true)
  created_at                DateTime            @default(now()) @db.Timestamptz(6)
  leave_allocations         leave_allocations[]
  leave_requests            leave_requests[]
}

model login_history {
  id             BigInt   @id @default(autoincrement())
  user_id        String?  @db.Uuid
  email_used     String
  success        Boolean
  failure_reason String?
  ip_address     String?  @db.Inet
  user_agent     String?
  logged_at      DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, logged_at(sort: Desc)], map: "idx_login_history_user")
}

model notifications {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String                 @db.Uuid
  type          notification_type_enum
  title         String                 @db.VarChar(150)
  message       String?
  related_table String?
  related_id    String?                @db.Uuid
